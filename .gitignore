# Tier 1: raw, per-subject records. Never committed.
data/raw/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Tier 2 (data/aggregates/, data/reference/) and tier 3 (docs/report.*) ARE
# committed. data/reference/ holds derived lookup tables with their provenance,
# never raw messages.

__pycache__/
*.py[cod]
.venv/
venv/
dist/
build/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Machine-readable output of `make coverage`, read by `tools/docs_audit.py` so
# that `tests_passing` and `coverage_percent` are enforced rather than typed.
# Ignored on purpose: it describes one run on one machine, and a committed copy
# would be a third place the same numbers could disagree.
.gate/
*.patch
*.diff
.env
*.log

# materialy nietechniczne: gate tools/check_no_private_artifacts.py
OUTREACH.md
LINKEDIN-POST.md
LINKEDIN-*.md
CONTACTS.md
HANDOVER-*.md
*-PITCH.md
outreach/*
